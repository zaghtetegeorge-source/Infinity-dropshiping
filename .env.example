# Copy this file to .env and fill in real values before going live.
# Every integration below degrades gracefully when left blank — the store
# still runs end-to-end (browsing, cart, Stripe checkout, admin) with zero
# marketing accounts connected. See SETUP.md for step-by-step instructions
# on obtaining each value.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Connection string for a Postgres database — see SETUP.md "Database" for
# how to provision a free one (Vercel Postgres/Neon takes ~2 minutes from
# the Vercel dashboard and can auto-fill this).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL — used in metadata, sitemap.xml, JSON-LD, Stripe redirect
# URLs, and tracking event source URLs. Must be the real production domain
# (https://...) before launch.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Default storefront currency. One of: AED, SAR, USD.
NEXT_PUBLIC_DEFAULT_CURRENCY="AED"
# WhatsApp number for the floating chat button, international format with
# no "+" or spaces, e.g. 971501234567.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ---------------------------------------------------------------------------
# Stripe (card payments + Apple Pay + Google Pay)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# From the Stripe CLI (`stripe listen`) in dev, or the webhook endpoint's
# signing secret in the Dashboard for production.
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Meta (Facebook/Instagram) — Pixel, Conversions API, Catalog feed
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=""
META_CONVERSIONS_API_TOKEN=""
# Optional: only set while testing CAPI events in Meta Events Manager's
# "Test Events" tab. Remove before launch.
META_TEST_EVENT_CODE=""
# Catalog ID from Commerce Manager, used to build product deep links for
# Advantage+ / Catalog Sales campaigns.
META_CATALOG_ID=""

# ---------------------------------------------------------------------------
# TikTok — Pixel, Events API, Catalog feed
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
TIKTOK_EVENTS_API_TOKEN=""
TIKTOK_CATALOG_ID=""

# ---------------------------------------------------------------------------
# Google — GA4, GTM, Merchant Center
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
GOOGLE_MERCHANT_CENTER_ID=""

# ---------------------------------------------------------------------------
# Email (order confirmations + abandoned cart recovery)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="orders@example.com"

# ---------------------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------------------
# Long random string used to sign admin session JWTs. Generate with:
#   openssl rand -base64 48
ADMIN_JWT_SECRET="dev-only-insecure-secret-change-me"
# Used by `npm run db:seed` (and the one-time /api/admin/seed endpoint
# below) to create the first admin login.
ADMIN_SEED_EMAIL="admin@infinitystore.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"
# Bearer token required by GET /api/admin/seed — a one-time bootstrap for a
# freshly connected production database when you have no local DB access.
# Generate with: openssl rand -hex 24
SEED_SECRET=""

# ---------------------------------------------------------------------------
# Product feed + cron protection
# ---------------------------------------------------------------------------
# Shared secret appended as ?token=... to the Meta/TikTok/Google feed URLs
# so they can't be scraped by competitors. Generate with: openssl rand -hex 24
FEED_ACCESS_TOKEN=""
# Bearer token required by the abandoned-cart cron endpoint
# (/api/cron/abandoned-cart). Generate with: openssl rand -hex 24
CRON_SECRET=""
